BREW_TAP="thruput-io/tap"
DEBIAN_INSTALL_COMMAND="apt-get update && apt-get install -y --no-install-recommends"
DARWIN_INSTALL_COMMAND="brew install --no-ask"
DEBIAN_BUILD_DEPS="jq bats bats-support bats-assert shellcheck golang-go kcov xmlstarlet dpkg-dev apt-utils debhelper lintian build-essential golang-any git curl ca-certificates perl checkmake python3-check-jsonschema pipx"
DARWIN_BUILD_DEPS="make jq bats-core bats-core/bats-core/bats-support bats-core/bats-core/bats-assert shellcheck go kcov bash xmlstarlet checkmake check-jsonschema"
DEBIAN_SEMGREP_INSTALL_COMMAND="PIPX_BIN_DIR=/usr/local/bin pipx install semgrep"
DARWIN_SEMGREP_INSTALL_COMMAND="brew install --no-ask semgrep"
DEBIAN_PACKAGE_FORMATS="deb"
DARWIN_PACKAGE_FORMATS="brew"
DEBIAN_BATS_LIB_PATH="/usr/lib/bats"
DARWIN_BATS_LIB_PATH="/opt/homebrew/lib"
DEBIAN_PATH_PREFIX="/usr/local/bin:"
DARWIN_PATH_PREFIX="/opt/homebrew/bin:"
DEBIAN_ADD_ARCHIVE='printf "Types: deb\nURIs: file:%s/build/dist/deb\nSuites: ./\nTrusted: yes\n" "$ROOT_DIR" > /etc/apt/sources.list.d/gettoken-dist.sources'
DARWIN_ADD_ARCHIVE='brew tap-new --no-git "$BREW_TAP" && brew trust "$BREW_TAP" && cp "$ROOT_DIR"/build/dist/brew/*.rb "$(brew --repository "$BREW_TAP")/Formula/"'
DEBIAN_REMOVE_PACKAGES='apt-get purge -y gettoken-secret-manager'
DARWIN_REMOVE_PACKAGES='brew uninstall --formula $(brew formulae | grep "^$BREW_TAP/") && brew untap "$BREW_TAP"'
DEBIAN_AS_AGENT='runuser -u nobody --'
DARWIN_AS_AGENT='sudo --preserve-env=INTEGRATIONTEST_TOKEN -u nobody'
DEBIAN_ADD_PUBLISHED_ARCHIVE='apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && curl -fsSL https://thruput.se/apt/thruput-io.sources > /etc/apt/sources.list.d/thruput-io.sources'
DARWIN_ADD_PUBLISHED_ARCHIVE='brew tap thruput-io/tap && brew trust thruput-io/tap'
DEBIAN_WAIT_FOR_PACKAGE='for _ in $(seq 1 40); do apt-get update && [ "$(apt-cache policy integration-test-tool | awk "/Candidate:/ { print \$2 }")" = "$VERSION" ] && break; sleep 15; done; [ "$(apt-cache policy integration-test-tool | awk "/Candidate:/ { print \$2 }")" = "$VERSION" ]'
DARWIN_WAIT_FOR_PACKAGE='for _ in $(seq 1 40); do brew update && [ "$(brew info --json=v2 thruput-io/tap/integration-test-tool | ruby -rjson -e "puts JSON.parse(STDIN.read)[\"formulae\"][0][\"versions\"][\"stable\"]")" = "$VERSION" ] && break; sleep 15; done; [ "$(brew info --json=v2 thruput-io/tap/integration-test-tool | ruby -rjson -e "puts JSON.parse(STDIN.read)[\"formulae\"][0][\"versions\"][\"stable\"]")" = "$VERSION" ]'
