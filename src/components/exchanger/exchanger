#!/usr/bin/env bash
set -euo pipefail

exchangers=__LIBDIR__/gettoken/exchangers

fields=$(parse exchange-request.schema.json wants)
wants=''
eval "$fields"

service=${wants%%/*}
plugin="$exchangers/$service.sh"

if [ ! -f "$plugin" ]; then
  echo "exchanger: no plugin serves $wants" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$plugin"

key=host-privileged/$service
export key
asked=$(format secret-get-request.schema.json key)

answer=$(printf '%s' "$asked" | secret-get)
fields=$(printf '%s' "$answer" | parse secret-get-response.schema.json value)
value=''
eval "$fields"

access_token=$(printf '%s' "$value" | exchange "$wants") || {
  failed=$?
  echo "exchanger: the plugin serving $wants failed" >&2
  exit "$failed"
}

expires_in=120
export access_token expires_in

format token-response.schema.json access_token expires_in
