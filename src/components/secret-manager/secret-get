#!/usr/bin/env bash
set -euo pipefail

store=${HOME:?secret-get: name the HOME the store is kept under}/secrets

fields=$(parse secret-get-request.schema.json key)
key=''
eval "$fields"

dir="$store/$key"

if [ -d "$dir" ]; then
  version=$(find "$dir" -maxdepth 1 -type f | sed 's|.*/||' \
    | awk '/^(0|[1-9][0-9]*)$/' | sort -n | tail -1)
else
  version=''
fi

if [ -z "$version" ]; then
  echo "secret-get: nothing is stored under $key" >&2
  exit 1
fi

value=$(cat "$dir/$version"; printf .)
value=${value%.}
export version value

format secret-get-response.schema.json version value
